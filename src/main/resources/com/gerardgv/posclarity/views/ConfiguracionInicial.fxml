<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gerardgv.posclarity.controllers.ConfiguracionInicialController">
   <children>
           <Label style="-fx-font-size:20px;" 
                  text="Configuración inicial PosClarity" />
           <Label text="Nombre sucursal" />
           <TextField fx:id="txtSucursal" 
                      promptText="Ejemplo: Matriz" />
           <Label text="Dirección" />
           <TextField fx:id="txtDireccion" />
           <Label text="Teléfono" />
           <TextField fx:id="txtTelefono" />
           <Label text="Caja Inicial"/>
           <TextField fx:id="txtCajaInicial" 
                      promptText="Ejemplo: 380.00"/>
           <Button onAction="#crearSistema" 
                   text="Crear sistema" />
   </children>
</VBox>
