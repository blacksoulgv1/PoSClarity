<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gerardgv.posclarity.controllers.TransferController"
           styleClass="pos-theme transfers-root"
           stylesheets="@/com/gerardgv/posclarity/css/theme/PosTheme.css,
                        @/com/gerardgv/posclarity/css/components/pos-card.css,
                        @/com/gerardgv/posclarity/css/components/pos-form.css,
                        @/com/gerardgv/posclarity/css/components/pos-buttons.css,
                        @/com/gerardgv/posclarity/css/components/pos-table.css,
                        @/com/gerardgv/posclarity/css/components/pos-badge.css,
                        @/com/gerardgv/posclarity/css/components/pos-textfield.css,
                        @/com/gerardgv/posclarity/css/components/pos-toast.css">


    <VBox spacing="18" styleClass="pos-view">
        <padding>
            <Insets top="22" right="24" bottom="20" left="24"/>
        </padding>

        <!-- ENCABEZADO -->
        <HBox alignment="CENTER_LEFT" spacing="14">
            <StackPane prefWidth="52" prefHeight="52"
                       styleClass="transfer-header-icon">
                <FontIcon iconLiteral="fas-exchange-alt"
                          iconSize="25"/>
            </StackPane>

            <VBox spacing="4">
                <Label text="Traspaso de inventario"
                       styleClass="clarity-title"/>
                <Label text="Movimiento de productos entre sucursales"
                       styleClass="pos-form-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="8"
                  styleClass="transfer-status">
                <FontIcon iconLiteral="fas-boxes" iconSize="15"/>
                <Label text="Control de inventario"/>
            </HBox>
        </HBox>

        <!-- SELECCIÓN DE SUCURSALES -->
        <HBox alignment="CENTER" spacing="18"
              styleClass="pos-card">
            <padding>
                <Insets top="18" right="22" bottom="18" left="22"/>
            </padding>

            <VBox spacing="9" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="fas-warehouse" iconSize="16"/>
                    <Label text="Sucursal origen"
                           styleClass="pos-form-label"/>
                </HBox>

                <ComboBox fx:id="cmbOrigen"
                          maxWidth="Infinity"
                          prefHeight="42"
                          promptText="Sucursal de origen"/>
            </VBox>

            <StackPane prefWidth="44" prefHeight="44"
                       styleClass="transfer-route-icon">
                <FontIcon iconLiteral="fas-arrow-right" iconSize="18"/>
            </StackPane>

            <VBox spacing="9" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <FontIcon iconLiteral="fas-map-marker-alt" iconSize="16"/>
                    <Label text="Sucursal destino"
                           styleClass="pos-form-label"/>
                </HBox>

                <ComboBox fx:id="cmbDestino"
                          maxWidth="Infinity"
                          prefHeight="42"
                          promptText="Selecciona la sucursal destino"/>
            </VBox>
        </HBox>

        <!-- ÁREA PRINCIPAL -->
        <HBox spacing="18" VBox.vgrow="ALWAYS">

            <!-- INVENTARIO DISPONIBLE -->
            <VBox spacing="14" HBox.hgrow="ALWAYS"
                  styleClass="pos-card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane prefWidth="38" prefHeight="38"
                               styleClass="transfer-section-icon">
                        <FontIcon iconLiteral="fas-box-open" iconSize="18"/>
                    </StackPane>

                    <VBox spacing="3">
                        <Label text="Inventario disponible"
                               styleClass="pos-section-title"/>
                        <Label text="Selecciona el producto que deseas trasladar"
                               styleClass="pos-form-subtitle"/>
                    </VBox>
                </HBox>

                <Separator/>

                <HBox alignment="CENTER_LEFT" spacing="8"
                      styleClass="transfer-search">
                    <FontIcon iconLiteral="fas-search" iconSize="15"/>
                    <TextField fx:id="txtBuscarInventario"
                               promptText="Buscar producto por modelo o marca..."
                               styleClass="clarity-search"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <TableView fx:id="tblInventarioOrigen"
                           VBox.vgrow="ALWAYS"
                           minHeight="180"
                           styleClass="pos-table">
                    <columns>
                        <TableColumn fx:id="colModelo"
                                     text="Modelo"
                                     prefWidth="145"
                                     minWidth="100"
                                     sortable="true"/>
                        <TableColumn fx:id="colMarca"
                                     text="Marca"
                                     prefWidth="120"
                                     minWidth="85"/>
                        <TableColumn fx:id="colCategoria"
                                     text="Categoría"
                                     prefWidth="115"
                                     minWidth="85"/>
                        <TableColumn fx:id="colStock"
                                     text="Stock"
                                     prefWidth="75"
                                     minWidth="60"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <Separator/>

                <VBox spacing="9">
                    <Label text="Cantidad a trasladar"
                           styleClass="pos-form-label"/>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <TextField fx:id="txtCantidad"
                                   promptText="Ingresa la cantidad"
                                   prefHeight="42"
                                   maxWidth="180"
                                   styleClass="pos-textfield"
                                   HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnAgregar"
                                mnemonicParsing="false"
                                prefHeight="42"
                                styleClass="button-primary"
                                maxWidth="150">
                            <graphic>
                                <FontIcon iconLiteral="fas-plus"
                                          iconSize="14"/>
                            </graphic>
                            <text>Agregar</text>
                        </Button>
                    </HBox>

                    <Label text="Selecciona una fila del inventario antes de agregar."
                           styleClass="pos-form-subtitle"
                           wrapText="true"/>
                </VBox>
            </VBox>

            <!-- RESUMEN Y CARRITO -->
            <VBox spacing="16" prefWidth="390"
                  minWidth="320" maxWidth="460">

                <!-- RESUMEN -->
                <HBox spacing="12" styleClass="pos-card">
                    <padding>
                        <Insets top="16" right="18" bottom="16" left="18"/>
                    </padding>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Resumen del traspaso"
                               styleClass="pos-section-title"/>
                        <Label text="Productos seleccionados"
                               styleClass="pos-form-subtitle"/>
                    </VBox>

                    <StackPane prefWidth="42" prefHeight="42"
                               styleClass="transfer-summary-icon">
                        <FontIcon iconLiteral="fas-clipboard-list"
                                  iconSize="20"/>
                    </StackPane>
                </HBox>

                <!-- DETALLE -->
                <VBox spacing="14" VBox.vgrow="ALWAYS"
                      styleClass="pos-card">
                    <padding>
                        <Insets top="20" right="18" bottom="18" left="18"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <FontIcon iconLiteral="fas-dolly"
                                  iconSize="18"/>
                        <Label text="Productos a trasladar"
                               styleClass="pos-section-title"/>
                    </HBox>

                    <Separator/>

                    <TableView fx:id="tblDetalle"
                               VBox.vgrow="ALWAYS"
                               minHeight="180"
                               styleClass="pos-table">
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10">
                                <FontIcon iconLiteral="fas-box-open"
                                          iconSize="28"/>
                                <Label text="Aún no hay productos"/>
                                <Label text="Agrega productos desde el inventario"
                                       wrapText="true"
                                       styleClass="pos-form-subtitle"/>
                            </VBox>
                        </placeholder>

                        <columns>
                            <TableColumn fx:id="colProductoDetalle"
                                         text="Producto"
                                         prefWidth="190"
                                         minWidth="120"/>
                            <TableColumn fx:id="colCantidadDetalle"
                                         text="Cantidad"
                                         prefWidth="90"
                                         minWidth="75"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <Separator/>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fas-info-circle"
                                  iconSize="14"/>
                        <Label text="Revisa las cantidades antes de confirmar."
                               wrapText="true"
                               styleClass="pos-form-subtitle"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>

        <!-- BARRA INFERIOR -->
        <HBox alignment="CENTER_LEFT" spacing="15"
              styleClass="pos-card">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>

            <FontIcon iconLiteral="fas-shield-alt" iconSize="18"/>

            <VBox spacing="3">
                <Label text="Verifica el destino y las cantidades"
                       styleClass="pos-section-title"/>
                <Label text="El inventario se actualizará al completar el traspaso."
                       styleClass="pos-form-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnTraspasar"
                    mnemonicParsing="false"
                    prefHeight="44"
                    prefWidth="205"
                    styleClass="button-success">
                <graphic>
                    <FontIcon iconLiteral="fas-check-circle"
                              iconSize="16"/>
                </graphic>
                <text>Realizar traspaso</text>
            </Button>
        </HBox>
    </VBox>
</StackPane>
