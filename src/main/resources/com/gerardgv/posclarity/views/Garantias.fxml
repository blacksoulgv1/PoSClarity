<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" styleClass="garantias-root" stylesheets="@/com/gerardgv/posclarity/css/theme/PosTheme.css,                         @/com/gerardgv/posclarity/css/pages/GarantiasView.css,                         @/com/gerardgv/posclarity/css/components/pos-card.css,                         @/com/gerardgv/posclarity/css/components/pos-form.css,                         @/com/gerardgv/posclarity/css/components/pos-buttons.css,                         @/com/gerardgv/posclarity/css/components/pos-table.css,                         @/com/gerardgv/posclarity/css/components/pos-badge.css,                         @/com/gerardgv/posclarity/css/components/pos-textfield.css,                         @/com/gerardgv/posclarity/css/components/pos-toast.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gerardgv.posclarity.controllers.GarantiasController">
    
    <children>

        <VBox fx:id="vistaGarantias" fillWidth="true" spacing="12" styleClass="garantias-view">

            <padding>
                <Insets bottom="14" left="18" right="18" top="14" />
            </padding>

            <!-- ================================================= -->
            <!-- CONTENIDO SUPERIOR                                 -->
            <!-- ================================================= -->

            <!-- ================================================= -->
            <!-- TABLA DE GARANTÍAS ACTIVAS                         -->
            <!-- ================================================= -->

            <SplitPane fx:id="splitGarantias" dividerPositions="0.62" orientation="VERTICAL" styleClass="garantias-split" VBox.vgrow="ALWAYS"><items><ScrollPane fx:id="scrollFormulario" fitToHeight="false" fitToWidth="true" hbarPolicy="AS_NEEDED" minHeight="300" pannable="true" styleClass="garantias-scroll" vbarPolicy="AS_NEEDED"><content><HBox fx:id="zonaSuperior" alignment="TOP_LEFT" fillHeight="true" spacing="12">

                <!-- ============================================= -->
                <!-- INFORMACIÓN DE LA GARANTÍA                     -->
                <!-- ============================================= -->

                <VBox fx:id="cardInformacion" maxWidth="430" minWidth="350" prefWidth="390" spacing="10" styleClass="pos-card garantia-info-card" HBox.hgrow="NEVER">

                    <padding>
                        <Insets bottom="14" left="16" right="16" top="14" />
                    </padding>

                    <!-- ENCABEZADO DE LA CARD -->

                    <HBox alignment="CENTER_LEFT" spacing="10">

                        <VBox spacing="3">

                            <Label styleClass="pos-section-title" text="Información de la garantía" />

                            <Label styleClass="pos-section-description" text="Busca la venta y registra los datos de la garantía." wrapText="true" />

                        </VBox>

                    </HBox>

                    <Separator />

                    <!-- FOLIO Y BÚSQUEDA -->

                    <GridPane hgap="14" vgap="7">

                        <columnConstraints>

                            <ColumnConstraints hgrow="ALWAYS" percentWidth="42" />

                            <ColumnConstraints hgrow="ALWAYS" percentWidth="58" />

                        </columnConstraints>

                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>

                        <!-- FOLIO -->

                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.rowSpan="2">

                            <Label styleClass="pos-field-label" text="Folio de garantía" />

                            <Label fx:id="lblFolio" styleClass="garantia-folio" text="GAR-000000" />

                        </VBox>

                        <!-- BUSCAR VENTA -->

                        <Label styleClass="pos-field-label" text="Buscar venta" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">

                            <TextField fx:id="txtFolioVenta" maxWidth="Infinity" promptText="Folio de venta" styleClass="pos-text-field" HBox.hgrow="ALWAYS" />

                            <Button fx:id="btnBuscar" minWidth="100" prefHeight="40" styleClass="pos-btn-primary" text="Buscar" />

                        </HBox>

                    </GridPane>

                    <!-- CLIENTE -->

                    <VBox spacing="5">

                        <Label styleClass="pos-field-label" text="Cliente" />

                        <Label fx:id="lblCliente" maxWidth="Infinity" styleClass="garantia-data-value" text="Sin venta seleccionada" wrapText="true" />

                    </VBox>

                    <!-- PRODUCTOS -->

                    <VBox spacing="5">

                        <Label styleClass="pos-field-label" text="Productos comprados" />

                        <TextArea fx:id="txtProductosVenta" editable="false" focusTraversable="false" maxHeight="68" maxWidth="Infinity" minHeight="58" prefRowCount="2" promptText="Aquí aparecerán los productos de la venta." styleClass="pos-text-area garantia-readonly-area" wrapText="true" />

                    </VBox>

                    <!-- MOTIVO Y ACCIÓN -->

                    <GridPane hgap="12" vgap="7">

                        <columnConstraints>

                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />

                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />

                        </columnConstraints>

                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>

                        <Label styleClass="pos-field-label" text="Motivo" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0" />

                        <ComboBox fx:id="cmbMotivo" maxWidth="Infinity" promptText="Seleccionar motivo" styleClass="pos-combo-box" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1" />

                    </GridPane>

                    <!-- ESTADO -->

                    <VBox spacing="5">

                        <Label text="Estado" StyleClass="pos-field-label"/>
                        
                        <Label fx:id ="lblEstado"
                                text="EN PROCESO"
                                maxWidth="Infinity"
                                alignment="CENTER"
                                styleClass="garantia-estado-badge estado-proceso"/>

                    </VBox>

                    <!-- BOTÓN GUARDAR -->

                    <Button fx:id="btnGuardar" maxHeight="38" maxWidth="Infinity" minHeight="38" prefHeight="38" styleClass="pos-btn-primary" text="Registrar garantía" />

                </VBox>

                <!-- ============================================= -->
                <!-- PANEL DE GRADUACIONES                          -->
                <!-- ============================================= -->

                <VBox fx:id="panelGraduaciones" 
                      minWidth="620" spacing="12" HBox.hgrow="ALWAYS">

                    <!-- ========================================= -->
                    <!-- GRADUACIÓN ORIGINAL                       -->
                    <!-- ========================================= -->

                    <VBox fx:id="cardGraduacionOriginal" spacing="10" styleClass="pos-card graduacion-card graduacion-original-card">

                        <padding>
                            <Insets bottom="14" left="16" right="16" top="14" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="3">
                                <Label styleClass="pos-section-title" text="Graduación Original" />
                                <Label styleClass="pos-section-description" text="Información registrada en la venta." />
                            </VBox>
                        </HBox>
                        <Separator />
                        
                        <GridPane hgap="6" maxWidth="Infinity" vgap="9">
                            <columnConstraints>
                                 <!-- OD / OI -->
                        <ColumnConstraints minWidth="34"
                                            prefWidth="40"
                                            maxWidth="45"/>
                            <!-- ESFERA -->
                        <ColumnConstraints minWidth="75"
                                            prefWidth="105"
                                            maxWidth="125"
                                            hgrow="ALWAYS"/>

                            <!-- CILINDRO -->
                        <ColumnConstraints minWidth="75"
                                            prefWidth="105"
                                            maxWidth="125"
                                            hgrow="ALWAYS"/>

                            <!-- EJE -->
                        <ColumnConstraints minWidth="65"
                                            prefWidth="85"
                                            maxWidth="105"
                                            hgrow="ALWAYS"/>

                            <!-- ADD -->
                        <ColumnConstraints minWidth="65"
                                            prefWidth="85"
                                            maxWidth="105"
                                            hgrow="ALWAYS"/>
                        </columnConstraints>
                            
                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>

                            <!-- ENCABEZADOS -->

                            <Label styleClass="graduacion-column-title" text="ESFERA" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label styleClass="graduacion-column-title" text="CILINDRO" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <Label styleClass="graduacion-column-title" text="EJE" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                            <Label styleClass="graduacion-column-title" text="ADD" GridPane.columnIndex="4" GridPane.rowIndex="0" />

                            <!-- OD -->

                            <Label styleClass="graduacion-eye-label" text="OD" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="txtEsfOD" editable="false" focusTraversable="false" maxWidth="Infinity" promptText="—" styleClass="graduacion-field readonly-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <TextField fx:id="txtCylOD" editable="false" focusTraversable="false" maxWidth="Infinity" promptText="—" styleClass="graduacion-field readonly-field" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <TextField fx:id="txtEjeOD" editable="false" focusTraversable="false" maxWidth="Infinity" promptText="—" styleClass="graduacion-field readonly-field" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            <TextField fx:id="txtAdd" editable="false" focusTraversable="false" maxWidth="Infinity" promptText="Sin ADD" styleClass="graduacion-field readonly-field" GridPane.columnIndex="4" GridPane.rowIndex="1" />

                            <!-- OI -->

                            <Label styleClass="graduacion-eye-label" text="OI" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <TextField fx:id="txtEsfOI" editable="false" focusTraversable="false" maxWidth="Infinity" promptText="—" styleClass="graduacion-field readonly-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <TextField fx:id="txtCylOI" editable="false" focusTraversable="false" maxWidth="Infinity" promptText="—" styleClass="graduacion-field readonly-field" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                            <TextField fx:id="txtEjeOI" editable="false" focusTraversable="false" maxWidth="Infinity" promptText="—" styleClass="graduacion-field readonly-field" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                        </GridPane>
                    </VBox>

                    <!-- ========================================= -->
                    <!-- GRADUACIÓN NUEVA                          -->
                    <!-- ========================================= -->

                    <VBox fx:id="cardGraduacionNueva" spacing="10" styleClass="pos-card graduacion-card graduacion-nueva-card">

                        <padding>
                            <Insets bottom="14" left="16" right="16" top="14" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">

                            <VBox spacing="3">

                                <Label styleClass="pos-section-title" text="Graduación Nueva" />
                                <Label styleClass="pos-section-description" text="Captura la nueva graduación de la garantía." />

                            </VBox>
                        </HBox>

                        <Separator />

                        <GridPane hgap="6" maxWidth="Infinity" vgap="9">

                        <columnConstraints>
                                 <!-- OD / OI -->
                        <ColumnConstraints minWidth="34" prefWidth="40" maxWidth="45"/>
                            <!-- ESFERA -->
                        <ColumnConstraints minWidth="75" prefWidth="105" maxWidth="125" hgrow="ALWAYS"/>
                            <!-- CILINDRO -->
                        <ColumnConstraints minWidth="75" prefWidth="105" maxWidth="125" hgrow="ALWAYS"/>
                            <!-- EJE -->
                        <ColumnConstraints minWidth="65" prefWidth="85" maxWidth="105" hgrow="ALWAYS"/>
                            <!-- ADD -->
                        <ColumnConstraints minWidth="65" prefWidth="85" maxWidth="105" hgrow="ALWAYS"/>
                        
                        </columnConstraints>

                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>

                            <!-- ENCABEZADOS -->

                            <Label styleClass="graduacion-column-title" text="ESFERA" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label styleClass="graduacion-column-title" text="CILINDRO" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <Label styleClass="graduacion-column-title" text="EJE" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                            <Label styleClass="graduacion-column-title" text="ADD" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                            <!-- OD -->

                            <Label styleClass="graduacion-eye-label" text="OD" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                            <TextField fx:id="txtEsfOD1" maxWidth="Infinity" promptText="0.00" styleClass="graduacion-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <TextField fx:id="txtCylOD1" maxWidth="Infinity" promptText="0.00" styleClass="graduacion-field" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                            <TextField fx:id="txtEjeOD1" maxWidth="Infinity" promptText="0" styleClass="graduacion-field" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                            <TextField fx:id="txtAdd1" maxWidth="Infinity" promptText="0.00" styleClass="graduacion-field" GridPane.columnIndex="4" GridPane.rowIndex="1" />

                            <!-- OI -->

                            <Label styleClass="graduacion-eye-label" text="OI" GridPane.columnIndex="0" GridPane.rowIndex="2" />

                            <TextField fx:id="txtEsfOI1" maxWidth="Infinity" promptText="0.00" styleClass="graduacion-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <TextField fx:id="txtCylOI1" maxWidth="Infinity" promptText="0.00" styleClass="graduacion-field" GridPane.columnIndex="2" GridPane.rowIndex="2" />

                            <TextField fx:id="txtEjeOI1" maxWidth="Infinity" promptText="0" styleClass="graduacion-field" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                        </GridPane>

                        <!-- INFORMACIÓN -->

                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="graduacion-info-box">

                            <Label styleClass="graduacion-help" text="OD: ojo derecho · OI: ojo izquierdo · El ADD se aplica a ambos ojos." wrapText="true" />

                        </HBox>

                    </VBox>

                </VBox>

            </HBox>

            </content></ScrollPane><VBox fx:id="cardTablaGarantias" minHeight="180" spacing="8" styleClass="pos-card garantias-table-card">

                <padding>
                    <Insets bottom="12" left="14" right="14" top="12" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">

                    <VBox spacing="3">

                        <Label styleClass="pos-section-title" text="Garantías activas" />

                        <Label styleClass="pos-section-description" text="Garantías en proceso, recibidas o pendientes de entrega." />

                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                </HBox>

                <TableView fx:id="tblGarantias" maxHeight="Infinity" minHeight="120" styleClass="pos-table" VBox.vgrow="ALWAYS">

                    <placeholder>
                        <Label styleClass="pos-table-placeholder" text="No hay garantías activas." />
                    </placeholder>

                    <columns>

                        <TableColumn fx:id="colFolio" minWidth="115" prefWidth="140" text="Folio" />

                        <TableColumn fx:id="colCliente" minWidth="180" prefWidth="240" text="Cliente" />

                        <TableColumn fx:id="colProducto" minWidth="230" prefWidth="330" text="Producto / Motivo" />

                        <TableColumn fx:id="colEstado" minWidth="120" prefWidth="145" text="Estado" />

                        <TableColumn fx:id="colFecha" minWidth="145" prefWidth="170" text="Fecha" />

                        <TableColumn fx:id="colAcciones" minWidth="150" prefWidth="190" sortable="false" text="Acciones" />

                    </columns>

                </TableView>

            </VBox>

        </items></SplitPane></VBox>

    </children>

</StackPane>
