<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root"
           styleClass="pos-theme clients-root"
           stylesheets="@/com/gerardgv/posclarity/css/pages/ClientsView.css,
                        @/com/gerardgv/posclarity/css/theme/PosTheme.css,
                        @/com/gerardgv/posclarity/css/components/pos-card.css,
                        @/com/gerardgv/posclarity/css/components/pos-form.css,
                        @/com/gerardgv/posclarity/css/components/pos-buttons.css,
                        @/com/gerardgv/posclarity/css/components/pos-table.css,
                        @/com/gerardgv/posclarity/css/components/pos-badge.css,
                        @/com/gerardgv/posclarity/css/components/pos-textfield.css,
                        @/com/gerardgv/posclarity/css/components/pos-toast.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gerardgv.posclarity.controllers.ClientsController">

    <HBox spacing="18"
          maxWidth="Infinity"
          maxHeight="Infinity">

        <!-- =====================================================
             FORMULARIO
             ===================================================== -->

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    prefWidth="430"
                    minWidth="430"
                    maxWidth="430"
                    styleClass="transparent-scroll">

            <content>
                <VBox spacing="14"
                      styleClass="clients-form-card">

                    <!-- TÍTULO -->

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fas-user"
                                  iconSize="18"
                                  styleClass="clarity-section-icon"/>

                        <Label text="Cliente"
                               styleClass="clarity-title"/>
                    </HBox>

                    <Label text="Alta y edición de clientes"
                           styleClass="pos-form-subtitle"/>

                    <Separator/>

                    <!-- DATOS GENERALES -->

                    <VBox spacing="4">
                        <HBox styleClass="pos-section-header">

                            <FontIcon iconLiteral="fas-user"
                                iconSize="16"
                                styleClass="pos-section-icon"/>

                            <Label text="Información general"
                                styleClass="pos-section-title"/>
                        </HBox>
                        <Separator styleClass="pos-section-separator"/>
                    </VBox>

                    <GridPane hgap="14"
                              vgap="12"
                              styleClass="pos-form-grid">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="30"/>
                            <ColumnConstraints percentWidth="70"/>
                        </columnConstraints>

                        <children>

                            <Label text="Nombre"
                                   styleClass="pos-form-label"/>

                            <TextField fx:id="txtNombre"
                                       promptText="Nombre completo"
                                       maxWidth="Infinity"
                                       GridPane.columnIndex="1"/>

                            <Label text="Teléfono"
                                   styleClass="pos-form-label"
                                   GridPane.rowIndex="1"/>

                            <TextField fx:id="txtTelefono"
                                       promptText="Número telefónico"
                                       maxWidth="Infinity"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"/>

                            <Label text="Dirección"
                                   styleClass="pos-form-label"
                                   GridPane.rowIndex="2"/>

                            <TextField fx:id="txtDireccion"
                                       promptText="Dirección del cliente"
                                       maxWidth="Infinity"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="2"/>

                        </children>
                    </GridPane>

                    <Separator/>

                    <!-- GRADUACIÓN -->

                    <VBox spacing="4">

                        <HBox styleClass="pos-section-header">

                            <FontIcon iconLiteral="fas-eye"
                                iconSize="16"
                                styleClass="pos-section-icon"/>
                            <Label text="Graduación"
                                styleClass="pos-section-title"/>
                        </HBox>

                        <Separator styleClass="pos-section-separator"/>
                    </VBox>

                    <GridPane hgap="8"
                              vgap="6"
                              styleClass="pos-form-grid">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="12"/>
                            <ColumnConstraints percentWidth="29"/>
                            <ColumnConstraints percentWidth="29"/>
                            <ColumnConstraints percentWidth="30"/>
                        </columnConstraints>

                        <children>

                            <!-- ENCABEZADOS -->

                            <Label text="ESFERA"
                                   styleClass="grad-title"
                                   GridPane.columnIndex="1"/>

                            <Label text="CILINDRO"
                                   styleClass="grad-title"
                                   GridPane.columnIndex="2"/>

                            <Label text="EJE"
                                   styleClass="grad-title"
                                   GridPane.columnIndex="3"/>

                            <!-- OD -->

                            <Label text="OD"
                                   styleClass="grad-title"
                                   GridPane.rowIndex="1"/>

                            <TextField fx:id="txtOdEsf"
                                       promptText="0.00"
                                       styleClass="grad-field"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"/>

                            <TextField fx:id="txtOdCil"
                                       promptText="0.00"
                                       styleClass="grad-field"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="1"/>

                            <TextField fx:id="txtOdEje"
                                       promptText="0"
                                       styleClass="grad-field"
                                       GridPane.columnIndex="3"
                                       GridPane.rowIndex="1"/>

                            <!-- OI -->

                            <Label text="OI"
                                   styleClass="pos-form-label"
                                   GridPane.rowIndex="2"/>

                            <TextField fx:id="txtOiEsf"
                                       promptText="0.00"
                                       styleClass="grad-field"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="2"/>

                            <TextField fx:id="txtOiCil"
                                       promptText="0.00"
                                       styleClass="grad-field"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="2"/>

                            <TextField fx:id="txtOiEje"
                                       promptText="0"
                                       styleClass="grad-field"
                                       GridPane.columnIndex="3"
                                       GridPane.rowIndex="2"/>
                            
                            <Label text="ADD"
                                   styleClass="pos-form-label"
                                   GridPane.rowIndex="3"/>

                            <TextField fx:id="txtAdd"
                                    styleClass="grad-field"
                                   promptText="0.00"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3"/>
                        </children>
                    </GridPane>
                    
                    <Separator/>

                    <!-- BOTONES -->

                    <HBox styleClass="pos-form-footer">

                        <Button fx:id="btnLimpiar"
                                text="Limpiar"
                                minWidth="115"
                                styleClass="pos-btn">

                            <graphic>
                                <FontIcon iconLiteral="fas-eraser"
                                          iconSize="14"/>
                            </graphic>
                        </Button>

                        <Button fx:id="btnGuardar"
                                text="Guardar"
                                minWidth="115"
                                styleClass="pos-btn-primary">

                            <graphic>
                                <FontIcon iconLiteral="fas-save"
                                          iconSize="14"/>
                            </graphic>
                        </Button>

                    </HBox>

                </VBox>
            </content>
        </ScrollPane>

        <!-- =====================================================
             CLIENTES REGISTRADOS
             ===================================================== -->

        <BorderPane minWidth="0"
                    minHeight="0"
                    styleClass="pos-card"
                    HBox.hgrow="ALWAYS">

            <!-- ENCABEZADO Y ESTADÍSTICAS -->

            <top>
                <VBox spacing="14">

                    <HBox alignment="CENTER_LEFT" spacing="8">

                        <FontIcon iconLiteral="fas-users"
                                  iconSize="18"
                                  styleClass="clarity-section-icon"/>

                        <Label text="Clientes registrados"
                               styleClass="clarity-title"/>
                    </HBox>

                    <!-- TARJETAS DE ESTADÍSTICAS -->

                    <GridPane hgap="8"
                              vgap="8">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>

                        <children>

                            <VBox alignment="CENTER"
                                  spacing="2"
                                  styleClass="pos-stat-card">

                                <Label fx:id="lblCompras"
                                       text="0"
                                       styleClass="pos-stat-value"/>

                                <Label text="Compras"
                                       styleClass="pos-stat-label"/>
                            </VBox>

                            <VBox alignment="CENTER"
                                  spacing="4"
                                  styleClass="pos-stat-card"
                                  GridPane.columnIndex="1">

                                <Label fx:id="lblTotalGastado"
                                       text="\$0.00"
                                       styleClass="pos-stat-value"/>

                                <Label text="Total gastado"
                                       styleClass="pos-stat-label"/>
                            </VBox>

                            <VBox alignment="CENTER"
                                  spacing="4"
                                  styleClass="pos-stat-card"
                                  GridPane.columnIndex="2">

                                <Label fx:id="lblUltimaVisita"
                                       text="-"
                                       styleClass="pos-stat-value"/>

                                <Label text="Última visita"
                                       styleClass="pos-stat-label"/>
                            </VBox>

                            <VBox alignment="CENTER"
                                  spacing="4"
                                  styleClass="pos-stat-card"
                                  GridPane.columnIndex="3">

                                <Label fx:id="lblClienteDesde"
                                       text="-"
                                       styleClass="pos-stat-value"/>

                                <Label text="Cliente desde"
                                       styleClass="pos-stat-label"/>
                            </VBox>

                        </children>
                    </GridPane>

                    <!-- BUSCADOR -->

                    <HBox styleClass="clarity-search"
                          HBox.hgrow="ALWAYS">

                        <children>
                            <FontIcon iconLiteral="fas-search"
                                      iconSize="15"/>

                            <TextField fx:id="txtBuscar"
                                       promptText="Buscar por nombre, teléfono o dirección..."
                                       HBox.hgrow="ALWAYS"/>
                        </children>
                    </HBox>

                    <padding>
                        <Insets bottom="14"/>
                    </padding>

                </VBox>
            </top>

            <!-- TABLA -->

            <center>
                <TableView fx:id="tblClientes"
                           minHeight="0"
                           styleClass="clients-table" >

                    <columns>
                        <TableColumn fx:id="colId"
                                     text="ID"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"/>

                        <TableColumn fx:id="colTelefono"
                                     text="Teléfono"/>

                        <TableColumn fx:id="colDireccion"
                                     text="Dirección"/>

                        <TableColumn fx:id="colGraduacion"
                                     text="Graduación"/>

                        <TableColumn fx:id="colEstado"
                                     text="Estado"/>

                        <TableColumn fx:id="colAcciones"
                                     text="Acciones"/>
                    </columns>

                </TableView>
            </center>

            <!-- FOOTER -->

            <bottom>
                <HBox minHeight="38"
                      prefHeight="38"
                      styleClass="clarity-table-footer">

                    <children>
                        <FontIcon iconLiteral="fas-users"
                                  iconSize="15"/>

                        <Label text="Directorio de clientes"
                               styleClass="clarity-table-footer-label"/>
                    </children>

                    <BorderPane.margin>
                        <Insets top="8"/>
                    </BorderPane.margin>

                </HBox>
            </bottom>

        </BorderPane>

    </HBox>

</StackPane>