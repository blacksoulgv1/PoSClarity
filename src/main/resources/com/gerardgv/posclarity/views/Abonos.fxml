<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="root"
           fx:controller="com.gerardgv.posclarity.controllers.AbonosController"
           styleClass="abonos-root">

    <stylesheets>
        <URL value="@/com/gerardgv/posclarity/css/theme/PosTheme.css"/>
        <URL value="@/com/gerardgv/posclarity/css/components/pos-table.css"/>
        <URL value="@/com/gerardgv/posclarity/css/pages/AbonosView.css"/>
    </stylesheets>

    <VBox spacing="18"
          maxWidth="760"
          prefWidth="760">

        <padding>
            <Insets top="22" right="24" bottom="22" left="24"/>
        </padding>

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT"
              spacing="12">

            <StackPane styleClass="abonos-header-icon-box"
                       prefWidth="46"
                       prefHeight="46">

                <FontIcon iconLiteral="fas-wallet"
                          iconSize="22"
                          styleClass="abonos-header-icon"/>
            </StackPane>

            <VBox spacing="2"
                  HBox.hgrow="ALWAYS">

                <Label text="Registrar abono"
                       styleClass="abonos-title"/>

                <Label text="Consulta el saldo y registra pagos de la venta"
                       styleClass="abonos-subtitle"/>
            </VBox>

            <Label fx:id="lblEstado"
                   text="Pendiente"
                   styleClass="abonos-status-badge"/>
        </HBox>

        <!-- INFORMACIÓN GENERAL -->
        <VBox spacing="10"
              styleClass="pos-card abonos-info-card">

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="2"
                      HBox.hgrow="ALWAYS">

                    <Label text="Folio"
                           styleClass="abonos-field-label"/>

                    <Label fx:id="lblFolio"
                           text="-"
                           styleClass="abonos-field-value"/>
                </VBox>

                <VBox spacing="2"
                      HBox.hgrow="ALWAYS">

                    <Label text="Cliente"
                           styleClass="abonos-field-label"/>

                    <Label fx:id="lblCliente"
                           text="Cliente no disponible"
                           styleClass="abonos-field-value"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- RESUMEN DE IMPORTES -->
        <GridPane hgap="12">

            <columnConstraints>
                <ColumnConstraints percentWidth="33.333"/>
                <ColumnConstraints percentWidth="33.333"/>
                <ColumnConstraints percentWidth="33.333"/>
            </columnConstraints>

            <VBox spacing="5"
                  GridPane.columnIndex="0"
                  styleClass="abonos-summary-card">

                <Label text="Total de venta"
                       styleClass="abonos-summary-label"/>

                <Label fx:id="lblTotal"
                       text="0.00"
                       styleClass="abonos-summary-value"/>
            </VBox>

            <VBox spacing="5"
                  GridPane.columnIndex="1"
                  styleClass="abonos-summary-card">

                <Label text="Pagado"
                       styleClass="abonos-summary-label"/>

                <Label fx:id="lblPagado"
                       text="0.00"
                       styleClass="abonos-summary-value abonos-summary-paid"/>
            </VBox>

            <VBox spacing="5"
                  GridPane.columnIndex="2"
                  styleClass="abonos-summary-card">

                <Label text="Saldo pendiente"
                       styleClass="abonos-summary-label"/>

                <Label fx:id="lblRestante"
                       text="0.00"
                       styleClass="abonos-summary-value abonos-summary-balance"/>
            </VBox>
        </GridPane>

        <!-- NUEVO ABONO -->
        <VBox spacing="12"
              styleClass="pos-card abonos-payment-card">

            <VBox spacing="2">

                <Label text="Nuevo abono"
                       styleClass="abonos-section-title"/>

                <Label text="Ingresa el importe y selecciona el método de pago"
                       styleClass="abonos-section-subtitle"/>
            </VBox>

            <HBox spacing="10"
                  alignment="BOTTOM_LEFT">

                <VBox spacing="6"
                      HBox.hgrow="ALWAYS">

                    <Label text="Monto"
                           styleClass="abonos-input-label"/>

                    <TextField fx:id="txtMonto"
                               promptText="Ej. 500.00"
                               prefHeight="42"
                               HBox.hgrow="ALWAYS"/>
                </VBox>

                <VBox spacing="6">

                    <Label text="Método de pago"
                           styleClass="abonos-input-label"/>

                    <ComboBox fx:id="cbMetodo"
                              prefWidth="180"
                              prefHeight="42"/>
                </VBox>

                <Button fx:id="btnAbonar"
                        text="Registrar abono"
                        onAction="#handleAbonar"
                        prefHeight="42"
                        styleClass="pos-btn-primary">

                    <graphic>
                        <FontIcon iconLiteral="fas-plus-circle"
                                  iconSize="16"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- HISTORIAL -->
        <VBox spacing="10"
              VBox.vgrow="ALWAYS"
              styleClass="pos-card abonos-history-card">

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="2"
                      HBox.hgrow="ALWAYS">

                    <Label text="Historial de pagos"
                           styleClass="abonos-section-title"/>

                    <Label text="Movimientos registrados para esta venta"
                           styleClass="abonos-section-subtitle"/>
                </VBox>

                <Label fx:id="lblTotalPagos"
                       text="0 pagos"
                       styleClass="abonos-record-count"/>
            </HBox>

            <Separator/>

            <TableView fx:id="tblPagos"
                       VBox.vgrow="ALWAYS"
                       prefHeight="250"
                       styleClass="pos-table">

                <columns>
                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="190"/>

                    <TableColumn fx:id="colMetodo"
                                 text="Método"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colMonto"
                                 text="Monto"
                                 prefWidth="160"/>
                </columns>
            </TableView>
        </VBox>

    </VBox>
</StackPane>