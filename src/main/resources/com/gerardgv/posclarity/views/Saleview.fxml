<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane  fx:id="rootSale"
            styleClass="pos-theme sale-root"
            stylesheets="@/com/gerardgv/posclarity/css/pages/SaleView.css,
                         @/com/gerardgv/posclarity/css/theme/PosTheme.css,
                         @/com/gerardgv/posclarity/css/components/pos-card.css,
                         @/com/gerardgv/posclarity/css/components/pos-buttons.css,
                         @/com/gerardgv/posclarity/css/components/pos-table.css,
                         @/com/gerardgv/posclarity/css/components/pos-badge.css,
                         @/com/gerardgv/posclarity/css/components/pos-textfield.css,
                         @/com/gerardgv/posclarity/css/components/pos-summary.css,
                         @/com/gerardgv/posclarity/css/components/pos-toast.css" 
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"            
            fx:controller="com.gerardgv.posclarity.controllers.SaleController">
    
    <HBox spacing="18" styleClass="sale-layout">
        
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            
            <!-- aquí pegas tu bloque de VENTA-->
            
            <VBox spacing="12" styleClass="pos-card sale-header-card">
        <children>
            
            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="fas-receipt" iconSize="18" styleClass="clarity-section-icon"/>
            <Label text="Venta" styleClass="clarity-title"/>
            </HBox>
            <Separator/>
            
            <GridPane hgap="14" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="10"/>
                    <ColumnConstraints percentWidth="23"/>
                    <ColumnConstraints percentWidth="10"/>
                    <ColumnConstraints percentWidth="23"/>
                    <ColumnConstraints percentWidth="10"/>
                    <ColumnConstraints percentWidth="24"/>
                </columnConstraints>

                <children>
                    <Label text="Colaborador" styleClass="field-label"/>
                    <HBox styleClass="input-icon" GridPane.columnIndex="1">
                        <children>
                            <FontIcon iconLiteral="fas-search" iconSize="15"/>
                                <TextField fx:id="txtColaborador"
                                    promptText="Buscar colaborador..."
                                    HBox.hgrow="ALWAYS"/>
                        </children>
                    </HBox>

                    <Label text="Fecha" styleClass="field-label" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtDate"
                               editable="false"
                               GridPane.columnIndex="3"/>

                    <Label text="Folio" styleClass="field-label" GridPane.columnIndex="4"/>
                    <TextField fx:id="txtFolio"
                               editable="false"
                               GridPane.columnIndex="5"/>

                    <Label text="Sucursal" styleClass="field-label" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtSucursal"
                               editable="false"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>

                    <Label text="Dirección" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtDireccionSuc"
                               editable="false"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="1"/>

                    <Label text="Teléfono" styleClass="field-label" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtTelefonoSuc"
                               editable="false"
                               GridPane.columnIndex="5"
                               GridPane.rowIndex="1"/>

                    <Label text="Cliente" styleClass="field-label" GridPane.rowIndex="2"/>
                    <HBox styleClass="input-icon" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <children>
                            <FontIcon iconLiteral="fas-search" iconSize="15"/>
                                <TextField fx:id="txtCliente"
                                    promptText="Buscar cliente..."
                                    HBox.hgrow="ALWAYS"/>
                        </children>
                    </HBox>

                    <Label text="Teléfono" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtTelefonoClient"
                               editable="false"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="2"/>

                    <Label text="Dirección" styleClass="field-label" GridPane.columnIndex="4" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtDireccionClient"
                               editable="false"
                               GridPane.columnIndex="5"
                               GridPane.rowIndex="2"/>
                </children>
            </GridPane>
        </children>
    </VBox>
    <VBox spacing="12" VBox.vgrow="ALWAYS" >

        <!-- 👓 GRADUACIÓN -->
        <VBox spacing="12" styleClass="pos-card sale-rx-card">
            
            <HBox alignment="CENTER_LEFT" spacing="8">
            <FontIcon iconLiteral="fas-eye" iconSize="18" styleClass="clarity-section-icon"/>
            <Label text="Graduación" styleClass="clarity-title"/>
            </HBox>

<Separator/>

            <GridPane hgap="35" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="18"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="22"/>
                </columnConstraints>

                <children>
                    <Label text="" />
                    <Label text="ESFERA" styleClass="rx-header" GridPane.columnIndex="1"/>
                    <Label text="CILINDRO" styleClass="rx-header" GridPane.columnIndex="2"/>
                    <Label text="EJE" styleClass="rx-header" GridPane.columnIndex="3"/>
                    <Label text="ADD" styleClass="rx-header" GridPane.columnIndex="4"/>

                    <Label text="OD" styleClass="field-label" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtEsfOD" prefWidth="95" maxWidth="95" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtCylOD" prefWidth="95" maxWidth="95" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtEjeOD" prefWidth="95" maxWidth="95" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtAdd" prefWidth="95" maxWidth="95" GridPane.columnIndex="4" GridPane.rowIndex="1"/>

                    <Label text="OI" styleClass="field-label" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtEsfOI" prefWidth="95" maxWidth="95" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtCylOI" prefWidth="95" maxWidth="95" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtEjeOI" prefWidth="95" maxWidth="95" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                </children>
            </GridPane>
        </VBox>

        <!-- 📦 PRODUCTOS -->
        <VBox spacing="14" styleClass="pos-card sale-products-card" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="fas-shopping-cart" iconSize="18" styleClass="clarity-section-icon"/>
                <Label text="Productos" styleClass="clarity-title"/>
            </HBox>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <HBox styleClass="clarity-search" HBox.hgrow="ALWAYS">
            <children>
                <FontIcon iconLiteral="fas-search" iconSize="15"/>
                <TextField fx:id="txtBuscarProductos"
                           promptText="Modelo / Producto"
                           HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>

        <Button text="Agregar"
                onAction="#agregarProducto"
                styleClass="pos-btn-primary">
            <graphic>
                <FontIcon iconLiteral="fas-plus-circle" iconSize="15"/>
            </graphic>
        </Button>
    </HBox>

    <TableView fx:id="tableProduct"  VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCantidad" text="Cantidad"/>
            <TableColumn fx:id="colModelo" text="Modelo"/>
            <TableColumn fx:id="colMarca" text="Marca"/>
            <TableColumn fx:id="colCategoria" text="Categoría"/>
            <TableColumn fx:id="colDescuento" text="Descuento"/>
            <TableColumn fx:id="colPrecio" text="Precio"/>
            <TableColumn fx:id="colSubtotal" text="Sub Total"/>
            <TableColumn fx:id="colAcciones" text="Acciones"/>
        </columns>
    </TableView>

    <HBox styleClass="clarity-table-footer">
        <children>
            <FontIcon iconLiteral="fas-shopping-cart" iconSize="15"/>
            <Label text="Productos en el carrito" styleClass="clarity-table-footer-label"/>
        </children>
    </HBox>

    </VBox>

    </VBox>
            
        </VBox>  
        
            <VBox prefWidth="320"
                    minWidth="320" 
                    maxWidth="320" 
                    spacing="14"
                    styleClass="pos-summary-card">

        <HBox alignment="CENTER_LEFT" spacing="8">
            <FontIcon iconLiteral="fas-cash-register" iconSize="18" styleClass="pos-section-icon"/>
            <Label text="Resumen de cobro" styleClass="pos-title"/>
        </HBox>

        <VBox spacing="10">
            <HBox styleClass="pos-summary-item">
                <children>
                    <VBox>
                        <Label text="Subtotal" styleClass="pos-summary-label"/>
                        <Label text="Antes de descuentos" styleClass="pos-summary-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotalBruto" text="\$0.00" styleClass="pos-summary-value"/>
                </children>
            </HBox>

            <HBox styleClass="pos-summary-item">
                <children>
                    <VBox>
                        <Label text="Descuento" styleClass="pos-summary-label"/>
                        <Label text="Promociones aplicadas" styleClass="pos-summary-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDescuento" text="\$0.00" styleClass="pos-summary-discount"/>
                </children>
            </HBox>

            <HBox styleClass="pos-summary-total">
                <children>
                    <VBox>
                        <Label text="Total" styleClass="pos-summary-total-label"/>
                        <Label text="Importe final" styleClass="pos-summary-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotal" text="\$0.00" styleClass="pos-summary-total-value"/>
                </children>
            </HBox>
        </VBox>

        <Separator/>

        <VBox spacing="10">
            <Label text="Método de pago" styleClass="field-label"/>
            <ComboBox fx:id="cbMetodoPago" maxWidth="Infinity"/>

            <Label text="Importe recibido" styleClass="field-label"/>
            <HBox styleClass="input-icon">
                <children>
                    <FontIcon iconLiteral="fas-dollar-sign" iconSize="15"/>
                    <TextField fx:id="txtMonto"
                               promptText="0.00"
                               HBox.hgrow="ALWAYS"/>
                </children>
            </HBox>
        </VBox>

        <VBox spacing="8">
            <HBox styleClass="pos-payment-row">
                <children>
                    <Label text="Restante" styleClass="pos-payment-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblRestante" text="\$0.00" styleClass="pos-payment-value"/>
                </children>
            </HBox>

            <HBox styleClass="pos-payment-row">
                <children>
                    <Label text="Cambio" styleClass="pos-payment-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblCambio" text="\$0.00" styleClass="pos-payment-value"/>
                </children>
            </HBox>
        </VBox>
        
        <Button text="COBRAR"
                onAction="#guardarVenta"
                maxWidth="Infinity"
                styleClass="pos-btn-charge">
            <graphic>
                <FontIcon iconLiteral="fas-credit-card" iconSize="16"/>
            </graphic>
        </Button>

    </VBox>
        
    </HBox> 

</StackPane>
