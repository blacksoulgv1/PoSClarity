<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:id="rootSale"
    styleClass="pos-theme sale-root"
    stylesheets="@/com/gerardgv/posclarity/css/pages/SaleView.css,
                 @/com/gerardgv/posclarity/css/components/pos-card.css,
                 @/com/gerardgv/posclarity/css/components/pos-buttons.css,
                 @/com/gerardgv/posclarity/css/components/pos-table.css,
                 @/com/gerardgv/posclarity/css/components/pos-badge.css,
                 @/com/gerardgv/posclarity/css/components/pos-textfield.css,
                 @/com/gerardgv/posclarity/css/components/pos-summary.css,
                 @/com/gerardgv/posclarity/css/components/pos-toast.css"
    fx:controller="com.gerardgv.posclarity.controllers.SaleController">

    <children>

        <!-- DISTRIBUCIÓN PRINCIPAL: VENTA + RESUMEN -->
        <HBox
            fx:id="saleLayout"
            spacing="8"
            minWidth="0"
            minHeight="0"
            maxWidth="Infinity"
            maxHeight="Infinity"
            fillHeight="true"
            styleClass="sale-layout">

            <children>

                <!-- =========================================
                     COLUMNA PRINCIPAL DE VENTA
                     Sin ScrollPane envolvente
                     ========================================= -->
                <VBox
                    fx:id="saleMainColumn"
                    spacing="12"
                    minWidth="0"
                    minHeight="0"
                    maxWidth="Infinity"
                    fillWidth="true"
                    HBox.hgrow="ALWAYS"
                    styleClass="sale-main-column">

                    <children>

                        <!-- DATOS GENERALES -->
                        <VBox spacing="12" styleClass="pos-card sale-header-card">
                            <children>

                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <children>
                                        <FontIcon
                                            iconLiteral="fas-receipt"
                                            iconSize="18"
                                            styleClass="clarity-section-icon"/>
                                        <Label
                                            text="Venta"
                                            styleClass="clarity-title"/>
                                    </children>
                                </HBox>

                                <Separator/>

                                <GridPane hgap="14" vgap="12">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="10" minWidth="0" hgrow="NEVER"/>
                                        <ColumnConstraints percentWidth="23" minWidth="0" hgrow="ALWAYS"/>
                                        <ColumnConstraints percentWidth="10" minWidth="0" hgrow="NEVER"/>
                                        <ColumnConstraints percentWidth="23" minWidth="0" hgrow="ALWAYS"/>
                                        <ColumnConstraints percentWidth="10" minWidth="0" hgrow="NEVER"/>
                                        <ColumnConstraints percentWidth="24" minWidth="0" hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <children>
                                        <Label text="Colaborador" styleClass="field-label"/>
                                        <HBox styleClass="input-icon" GridPane.columnIndex="1">
                                            <children>
                                                <FontIcon iconLiteral="fas-search" iconSize="15"/>
                                                <TextField fx:id="txtColaborador" editable="false" minWidth="0" HBox.hgrow="ALWAYS"/>
                                            </children>
                                        </HBox>

                                        <Label text="Fecha" styleClass="field-label" GridPane.columnIndex="2"/>
                                        <TextField fx:id="txtDate" editable="false" minWidth="0" GridPane.columnIndex="3"/>

                                        <Label text="Folio" styleClass="field-label" GridPane.columnIndex="4"/>
                                        <TextField fx:id="txtFolio" editable="false" minWidth="0" GridPane.columnIndex="5"/>

                                        <Label text="Sucursal" styleClass="field-label" GridPane.rowIndex="1"/>
                                        <TextField fx:id="txtSucursal" editable="false" minWidth="0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                        <Label text="Dirección" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                        <TextField fx:id="txtDireccionSuc" editable="false" minWidth="0" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                        <Label text="Teléfono" styleClass="field-label" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                                        <TextField fx:id="txtTelefonoSuc" editable="false" minWidth="0" GridPane.columnIndex="5" GridPane.rowIndex="1"/>

                                        <Label text="Cliente" styleClass="field-label" GridPane.rowIndex="2"/>
                                        <HBox styleClass="input-icon" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <children>
                                                <FontIcon iconLiteral="fas-search" iconSize="15"/>
                                                <TextField fx:id="txtCliente" promptText="Buscar cliente..." minWidth="0" HBox.hgrow="ALWAYS"/>
                                            </children>
                                        </HBox>

                                        <Label text="Teléfono" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                        <TextField fx:id="txtTelefonoClient" editable="false" minWidth="0" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                                        <Label text="Dirección" styleClass="field-label" GridPane.columnIndex="4" GridPane.rowIndex="2"/>
                                        <TextField fx:id="txtDireccionClient" editable="false" minWidth="0" GridPane.columnIndex="5" GridPane.rowIndex="2"/>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <!-- GRADUACIÓN Y PRODUCTOS -->
                        <VBox
                            spacing="12"
                            minWidth="0"
                            minHeight="0"
                            fillWidth="true"
                            VBox.vgrow="ALWAYS">

                            <children>

                                <!-- GRADUACIÓN -->
                                <VBox spacing="12" styleClass="pos-card sale-rx-card">
                                    <children>

                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <FontIcon iconLiteral="fas-eye" iconSize="18" styleClass="clarity-section-icon"/>
                                                <Label text="Graduación" styleClass="clarity-title"/>
                                            </children>
                                        </HBox>

                                        <Separator/>

                                        <GridPane hgap="12" vgap="10">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="12" minWidth="0"/>
                                                <ColumnConstraints percentWidth="22" minWidth="0" hgrow="ALWAYS"/>
                                                <ColumnConstraints percentWidth="22" minWidth="0" hgrow="ALWAYS"/>
                                                <ColumnConstraints percentWidth="22" minWidth="0" hgrow="ALWAYS"/>
                                                <ColumnConstraints percentWidth="22" minWidth="0" hgrow="ALWAYS"/>
                                            </columnConstraints>

                                            <children>
                                                <Label text=""/>
                                                <Label text="ESFERA" styleClass="rx-header" GridPane.columnIndex="1"/>
                                                <Label text="CILINDRO" styleClass="rx-header" GridPane.columnIndex="2"/>
                                                <Label text="EJE" styleClass="rx-header" GridPane.columnIndex="3"/>
                                                <Label text="ADD" styleClass="rx-header" GridPane.columnIndex="4"/>

                                                <Label text="OD" styleClass="field-label" GridPane.rowIndex="1"/>
                                                <TextField fx:id="txtEsfOD" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                                <TextField fx:id="txtCylOD" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                                <TextField fx:id="txtEjeOD" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                                                <TextField fx:id="txtAdd" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="4" GridPane.rowIndex="1"/>

                                                <Label text="OI" styleClass="field-label" GridPane.rowIndex="2"/>
                                                <TextField fx:id="txtEsfOI" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                                <TextField fx:id="txtCylOI" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                                                <TextField fx:id="txtEjeOI" minWidth="0" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>

                                <!-- PRODUCTOS -->
                                <VBox
                                    spacing="14"
                                    minWidth="0"
                                    minHeight="0"
                                    styleClass="pos-card sale-products-card"
                                    VBox.vgrow="ALWAYS">

                                    <children>

                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <FontIcon iconLiteral="fas-shopping-cart" iconSize="18" styleClass="clarity-section-icon"/>
                                                <Label text="Productos" styleClass="clarity-title"/>
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <children>
                                                <HBox styleClass="clarity-search" minWidth="0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <FontIcon iconLiteral="fas-search" iconSize="15"/>
                                                        <TextField fx:id="txtBuscarProductos" promptText="Modelo / Producto" minWidth="0" HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>

                                                <Button
                                                    text="Agregar"
                                                    onAction="#agregarProducto"
                                                    styleClass="pos-btn-primary">
                                                    <graphic>
                                                        <FontIcon iconLiteral="fas-plus-circle" iconSize="15"/>
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </HBox>

                                        <TableView
                                            fx:id="tableProduct"
                                            minWidth="0"
                                            minHeight="60"
                                            VBox.vgrow="ALWAYS">

                                            <columns>
                                                <TableColumn fx:id="colCantidad" text="Cantidad"/>
                                                <TableColumn fx:id="colModelo" text="Modelo"/>
                                                <TableColumn fx:id="colMarca" text="Marca"/>
                                                <TableColumn fx:id="colCategoria" text="Categoría"/>
                                                <TableColumn fx:id="colDescuento" text="Descuento"/>
                                                <TableColumn fx:id="colPrecio" text="Precio"/>
                                                <TableColumn fx:id="colSubtotal" text="Sub Total"/>
                                                <TableColumn fx:id="colAcciones" text="Acciones"/>
                                            </columns>
                                        </TableView>

                                        <HBox styleClass="clarity-table-footer">
                                            <children>
                                                <FontIcon iconLiteral="fas-shopping-cart" iconSize="15"/>
                                                <Label text="Productos en el carrito" styleClass="clarity-table-footer-label"/>
                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- =========================================
                     RESUMEN DE COBRO
                     Se mantiene fijo a la derecha.
                     Solo este panel conserva ScrollPane.
                     ========================================= -->
                <ScrollPane
                    fx:id="saleSummaryScroll"
                    fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    minWidth="260"
                    prefWidth="310"
                    maxWidth="320"
                    minHeight="0"
                    HBox.hgrow="NEVER"
                    styleClass="sale-summary-scroll">

                    <content>
                        <VBox
                            fx:id="saleSummary"
                            minWidth="0"
                            prefWidth="300"
                            maxWidth="Infinity"
                            spacing="10"
                            styleClass="pos-summary-card">

                            <children>

                                <!-- SEGURO CLARITY -->
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <children>
                                        <FontIcon iconLiteral="fas-cash-register" iconSize="18" styleClass="pos-section-icon"/>
                                        <Label text="Resumen de cobro" styleClass="pos-title"/>
                                    </children>
                                </HBox>

                                <VBox spacing="8" styleClass="pos-summary-insurance">
                                    <children>

                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <children>
                                                <CheckBox fx:id="chkSeguro" text="Seguro"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="lblSeguroCobertura" text="70%" styleClass="pos-summary-value"/>
                                            </children>
                                        </HBox>

                                        <VBox spacing="4">
                                            <children>
                                                <HBox>
                                                    <children>
                                                        <Label text="Monto asegurable" styleClass="pos-summary-label"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Label fx:id="lblSeguroAsegurable" text="\$0.00" styleClass="pos-summary-value"/>
                                                    </children>
                                                </HBox>

                                                <HBox>
                                                    <children>
                                                        <Label text="Cobertura Clarity" styleClass="pos-summary-label"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Label fx:id="lblSeguroCoberturaMonto" text="\$0.00" styleClass="pos-summary-value"/>
                                                    </children>
                                                </HBox>

                                                <HBox>
                                                    <children>
                                                        <Label text="A cargo del cliente" styleClass="pos-summary-label"/>
                                                        <Region HBox.hgrow="ALWAYS"/>
                                                        <Label fx:id="lblSeguroCliente" text="\$0.00" styleClass="pos-summary-total-value"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <Separator/>

                                <!-- TOTALES -->
                                <VBox spacing="10">
                                    <children>

                                        <HBox styleClass="pos-summary-item">
                                            <children>
                                                <VBox>
                                                    <children>
                                                        <Label text="Subtotal" styleClass="pos-summary-label"/>
                                                        <Label text="Antes de descuentos" styleClass="pos-summary-subtitle"/>
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="lblTotalBruto" text="\$0.00" styleClass="pos-summary-value"/>
                                            </children>
                                        </HBox>

                                        <HBox styleClass="pos-summary-item">
                                            <children>
                                                <VBox>
                                                    <children>
                                                        <Label text="Descuento" styleClass="pos-summary-label"/>
                                                        <Label text="Promociones aplicadas" styleClass="pos-summary-subtitle"/>
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="lblDescuento" text="\$0.00" styleClass="pos-summary-discount"/>
                                            </children>
                                        </HBox>

                                        <HBox styleClass="pos-summary-total">
                                            <children>
                                                <VBox>
                                                    <children>
                                                        <Label text="Total" styleClass="pos-summary-total-label"/>
                                                        <Label text="Importe final" styleClass="pos-summary-subtitle"/>
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="lblTotal" text="\$0.00" styleClass="pos-summary-total-value"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <Separator/>

                                <!-- DATOS DE PAGO -->
                                <VBox spacing="10">
                                    <children>

                                        <Label text="Método de pago" styleClass="field-label"/>
                                        <ComboBox fx:id="cbMetodoPago" maxWidth="Infinity"/>

                                        <Label text="Cupón de descuento" styleClass="field-label"/>
                                        <HBox styleClass="input-icon">
                                            <children>
                                                <FontIcon iconLiteral="fas-ticket-alt" iconSize="15"/>
                                                <TextField fx:id="txtCupon" promptText="Código de cupón" minWidth="0" HBox.hgrow="ALWAYS"/>
                                            </children>
                                        </HBox>

                                        <Label text="Importe recibido" styleClass="field-label"/>
                                        <HBox styleClass="input-icon">
                                            <children>
                                                <FontIcon iconLiteral="fas-dollar-sign" iconSize="15"/>
                                                <TextField fx:id="txtMonto" promptText="0.00" minWidth="0" HBox.hgrow="ALWAYS"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- RESTANTE Y CAMBIO -->
                                <VBox spacing="8">
                                    <children>

                                        <HBox styleClass="pos-payment-row">
                                            <children>
                                                <Label text="Restante" styleClass="pos-payment-label"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="lblRestante" text="\$0.00" styleClass="pos-payment-value"/>
                                            </children>
                                        </HBox>

                                        <HBox styleClass="pos-payment-row">
                                            <children>
                                                <Label text="Cambio" styleClass="pos-payment-label"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="lblCambio" text="\$0.00" styleClass="pos-payment-value"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- BOTÓN COBRAR -->
                                <Button
                                    text="COBRAR"
                                    onAction="#guardarVenta"
                                    maxWidth="Infinity"
                                    styleClass="pos-btn-charge">
                                    <graphic>
                                        <FontIcon iconLiteral="fas-credit-card" iconSize="16"/>
                                    </graphic>
                                </Button>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

            </children>
        </HBox>
    </children>
</StackPane>
