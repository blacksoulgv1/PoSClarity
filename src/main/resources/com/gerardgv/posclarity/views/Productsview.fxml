<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root"
           styleClass="pos-theme products-root"
           stylesheets="@/com/gerardgv/posclarity/css/theme/PosTheme.css,
                        @/com/gerardgv/posclarity/css/components/pos-card.css,
                        @/com/gerardgv/posclarity/css/components/pos-form.css,
                        @/com/gerardgv/posclarity/css/components/pos-buttons.css,
                        @/com/gerardgv/posclarity/css/components/pos-table.css,
                        @/com/gerardgv/posclarity/css/components/pos-badge.css,
                        @/com/gerardgv/posclarity/css/components/pos-textfield.css,
                        @/com/gerardgv/posclarity/css/components/pos-toast.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gerardgv.posclarity.controllers.ProductsController">

    <HBox spacing="18"  maxHeight="Infinity" styleClass="products-layout">

        <!-- FORMULARIO -->
        <VBox prefWidth="390"
              minWidth="390"
              maxWidth="390"
              spacing="14"
              styleClass="pos-card">

            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="fas-box" iconSize="18" styleClass="clarity-section-icon"/>
                <Label text="Producto" styleClass="clarity-title"/>
            </HBox>

            <Label text="Alta y edición de productos del inventario"
                   styleClass="pos-form-subtitle"/>

            <Separator/>

            <GridPane hgap="14" vgap="12" styleClass="pos-form-grid">
                <columnConstraints>
                    <ColumnConstraints percentWidth="32"/>
                    <ColumnConstraints percentWidth="68"/>
                </columnConstraints>

                <children>
                    <Label text="Modelo" styleClass="pos-form-label"/>
                    <TextField fx:id="txtModelo"
                               promptText="Modelo del producto"
                               GridPane.columnIndex="1"/>

                    <Label text="Marca" styleClass="pos-form-label" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtMarca"
                               promptText="Marca"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>

                    <Label text="Categoría" styleClass="pos-form-label" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="cbCategoria"
                              maxWidth="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="2"/>

                    <Label text="Tipo" styleClass="pos-form-label" GridPane.rowIndex="3"/>
                    <ComboBox fx:id="cbTipo"
                              maxWidth="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="3"/>

                    <Label text="Precio" styleClass="pos-form-label" GridPane.rowIndex="4"/>
                    <HBox styleClass="input-icon"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4">
                        <children>
                            <FontIcon iconLiteral="fas-dollar-sign" iconSize="14"/>
                            <TextField fx:id="txtPrecio"
                                       promptText="0.00"
                                       HBox.hgrow="ALWAYS"/>
                        </children>
                    </HBox>

                    <Label text="Stock" styleClass="pos-form-label" GridPane.rowIndex="5"/>
                    <HBox styleClass="input-icon"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="5">
                        <children>
                            <FontIcon iconLiteral="fas-cubes" iconSize="14"/>
                            <TextField fx:id="txtStock"
                                       promptText="0"
                                       HBox.hgrow="ALWAYS"/>
                        </children>
                    </HBox>
                </children>
            </GridPane>

            <HBox styleClass="pos-form-footer">
                <Button fx:id="btnClear"
                        text="Limpiar"
                        minWidth="110"
                        styleClass="pos-btn">
                    <graphic>
                        <FontIcon iconLiteral="fas-eraser" iconSize="14"/>
                    </graphic>
                </Button>

                <Button fx:id="btnGuardar"
                        text="Guardar"
                        minWidth="110"
                        styleClass="pos-btn-primary">
                    <graphic>
                        <FontIcon iconLiteral="fas-save" iconSize="14"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- TABLA -->
        <BorderPane minHeight="0"
            styleClass="pos-card"
            HBox.hgrow="ALWAYS">

    <top>
        <VBox spacing="14">

            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="fas-list"
                          iconSize="18"
                          styleClass="clarity-section-icon"/>
                <Label text="Productos registrados"
                       styleClass="clarity-title"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <HBox styleClass="clarity-search"
                      HBox.hgrow="ALWAYS">
                    <children>
                        <FontIcon iconLiteral="fas-search"
                                  iconSize="15"/>
                        <TextField fx:id="txtBuscar"
                                   promptText="Buscar por modelo o marca..."
                                   HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>
            </HBox>

            <padding>
                <Insets bottom="14"/>
            </padding>

        </VBox>
    </top>

    <center>
        <TableView fx:id="tblProductos"
                   minHeight="0">
            <columns>
                <TableColumn fx:id="colId" text="ID"/>
                <TableColumn fx:id="colModelo" text="Modelo"/>
                <TableColumn fx:id="colMarca" text="Marca"/>
                <TableColumn fx:id="colCategoria" text="Categoría"/>
                <TableColumn fx:id="colTipo" text="Tipo"/>
                <TableColumn fx:id="colPrecio" text="Precio"/>
                <TableColumn fx:id="colStock" text="Stock"/>
                <TableColumn fx:id="colActivo" text="Estado"/>
                <TableColumn fx:id="colAcciones" text="Acciones"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox minHeight="38"
              prefHeight="38"
              styleClass="clarity-table-footer">

            <children>
                <FontIcon iconLiteral="fas-boxes"
                          iconSize="15"/>
                <Label text="Catálogo de productos"
                       styleClass="clarity-table-footer-label"/>
            </children>

            <BorderPane.margin>
                <Insets top="8"/>
            </BorderPane.margin>

        </HBox>
    </bottom>

</BorderPane>

    </HBox>

</StackPane>