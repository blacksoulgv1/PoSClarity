<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gerardgv.posclarity.controllers.EmpleadosController">
    <center>
      <SplitPane fx:id="splitPane" dividerPositions="0.35" styleClass="main-split">
         <items>
            <VBox prefWidth="250.0" spacing="10.0" styleClass="form-panel">
               <padding>
                  <Insets top="10.0" />
               </padding>
               <children>
                  <Label alignment="CENTER_RIGHT" styleClass="form-title" text="Alta / Edición de Empleados">
                     <VBox.margin>
                        <Insets left="10.0" />
                     </VBox.margin></Label>
                  
                  <GridPane hgap="15.0" prefHeight="144.0" prefWidth="406.0" vgap="18">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="202.0" minWidth="10.0" prefWidth="86.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="322.0" minWidth="10.0" prefWidth="322.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="50.0" vgrow="NEVER" />
                        <RowConstraints minHeight="50.0" vgrow="NEVER" />
                        <RowConstraints minHeight="50.0" vgrow="NEVER" />
                    </rowConstraints>
                     <children>
                        <Label styleClass="form-label" text="Codigo de Empleado" />
                        <TextField fx:id="txtCodigo" maxWidth="Infinity" styleClass="text-field" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />
                        <Label styleClass="form-label" text="Nombre Completo" GridPane.rowIndex="1" />
                        <TextField fx:id="txtEmpleado" maxWidth="Infinity" styleClass="text-field" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />
                        <Label styleClass="form-label" text="Rol" GridPane.rowIndex="2" />
                        <ComboBox fx:id="cbRol" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     </children>
                     <VBox.margin>
                        <Insets left="10.0" right="15.0" />
                     </VBox.margin>
                     <padding>
                        <Insets bottom="20" left="25" right="25" top="20" />
                     </padding>
                  </GridPane>
                  <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primary" text="Guardar" />
                        <Button fx:id="btnClear" mnemonicParsing="false" text="Limpiar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="8.0">
               <children>
                  <HBox prefWidth="200.0" spacing="8.0" styleClass="table-panel">
                     <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar por código o nombre" styleClass="search-field" />
                     </children>
                  </HBox>
                  <TableView fx:id="tblEmpleados" prefHeight="252.0" prefWidth="776.0">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="75.0" text="Id" />
                      <TableColumn fx:id="colCodigo" prefWidth="75.0" text="Codigo" />
                        <TableColumn fx:id="colEmpleado" prefWidth="75.0" text="Empleado" />
                        <TableColumn fx:id="colRol" prefWidth="75.0" text="Rol" />
                        <TableColumn fx:id="colActivo" prefWidth="75.0" text="Estado" />
                        <TableColumn fx:id="colAcciones" prefWidth="75.0" text="Acciones" />
                    </columns>
                  </TableView>
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </VBox>
         </items>
      </SplitPane>
   </center>
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="10.0" styleClass="header-bar">
         <padding>
            <Insets left="25" right="25" />
         </padding>
         <children>
            <Label styleClass="header-title" text="Empleados" />
         </children>
      </HBox>
   </top>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER_RIGHT">
         <padding>
            <Insets top="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
