<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="mainBorderPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gerardgv.posclarity.controllers.MainController"
            stylesheets="@../css/main-layout.css"
            styleClass="main-root">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="14">
            <padding>
                <Insets top="12" right="22" bottom="12" left="18"/>
            </padding>

            <Button fx:id="toggleMenuButton"
                    text=""
                    onAction="#toggleMenu"
                    styleClass="icon-button">
                <graphic>
                    <FontIcon iconLiteral="fas-bars" iconSize="18"/>
                </graphic>
                <tooltip>
                    <Tooltip text="Contraer o expandir menú"/>
                </tooltip>
            </Button>

            <VBox spacing="3">
                <Label text="Ópticas Clarity" styleClass="app-title"/>
                <Label fx:id="currentViewLabel"
                       text="Ventas"
                       styleClass="app-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="7" styleClass="connection-indicator">
                <FontIcon fx:id="connectionIcon"
                          iconLiteral="fas-circle"
                          iconSize="9"/>
                <Label fx:id="connectionStatusLabel"
                       text="Conexión pendiente"
                       styleClass="connection-label"/>
            </HBox>

            <Separator orientation="VERTICAL" prefHeight="34"/>

            <VBox spacing="3" styleClass="branch-summary">
                <Label text="SUCURSAL" styleClass="header-caption"/>
                <Label fx:id="branchLabel"
                       text="Sin sucursal"
                       styleClass="header-value"/>
            </VBox>

            <MenuButton fx:id="userMenuButton"
                        text="Usuario"
                        styleClass="user-menu-button">
                <graphic>
                    <FontIcon iconLiteral="fas-user-circle" iconSize="24"/>
                </graphic>
                <items>
                    <MenuItem text="Mi perfil" onAction="#abrirPerfil"/>
                    <MenuItem text="Cambiar contraseña" onAction="#cambiarContrasena"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Cerrar sesión" onAction="#cerrarSesion"/>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <left>
        <ScrollPane fx:id="sideMenuScroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="side-menu-scroll">

            <content>
                <VBox fx:id="sideMenu" styleClass="side-menu" spacing="8">
                    <HBox alignment="CENTER" styleClass="brand-container">
                        <ImageView fx:id="brandLogo"
                                   fitWidth="76"
                                   fitHeight="76"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../img/Logo-Clarity.png"/>
                            </image>
                        </ImageView>
                    </HBox>

                    <Label text="PosClarity"
                           styleClass="brand-title"
                           maxWidth="Infinity"/>

                    <Label text="VENTAS" styleClass="menu-section"/>

                    <Button fx:id="btnVentas"
                            text="Ventas"
                            onAction="#abrirNuevaVenta"
                            styleClass="menu-button">
                        <graphic><FontIcon iconLiteral="fas-shopping-cart" iconSize="18"/></graphic>
                    </Button>

                    <Button fx:id="btnPendientes"
                            text="Ventas Pendientes"
                            onAction="#abrirAbono"
                            styleClass="menu-button">
                        <graphic><FontIcon iconLiteral="fas-clock" iconSize="18"/></graphic>
                    </Button>

                    <Button fx:id="btnGarantias"
                            text="Garantías"
                            onAction="#AbrirGarantias"
                            styleClass="menu-button">
                        <graphic><FontIcon iconLiteral="fas-shield-alt" iconSize="18"/></graphic>
                    </Button>

                    <Label text="INVENTARIO" styleClass="menu-section"/>

                    <Button fx:id="btnProductos"
                            text="Productos"
                            onAction="#abrirProductos"
                            styleClass="menu-button">
                        <graphic><FontIcon iconLiteral="fas-box" iconSize="18"/></graphic>
                    </Button>

                    <Button fx:id="btnTraspasos"
                            text="Traspasos"
                            onAction="#abrirTraspaso"
                            styleClass="menu-button">
                        <graphic><FontIcon iconLiteral="fas-exchange-alt" iconSize="18"/></graphic>
                    </Button>

                    <Button fx:id="btnDescuentos"
                            text="Descuentos"
                            onAction="#abrirDescuento"
                            styleClass="menu-button">
                        <graphic><FontIcon iconLiteral="fas-tags" iconSize="18"/></graphic>
                    </Button>

                    <Label text="CATÁLOGOS" styleClass="menu-section"/>

                    <Button fx:id="btnClientes"
                            text="Clientes"
                            onAction="#abrirClientes"
                            styleClass="menu-button">
                        <graphic><FontIcon iconLiteral="fas-users" iconSize="18"/></graphic>
                    </Button>

                    <Button fx:id="btnSucursales"
                            text="Sucursales"
                            onAction="#abrirSucursales"
                            styleClass="menu-button">
                        <graphic><FontIcon iconLiteral="fas-store" iconSize="18"/></graphic>
                    </Button>

                    <Button fx:id="btnColaboradores"
                            text="Colaboradores"
                            onAction="#abrirEmpleados"
                            styleClass="menu-button">
                        <graphic><FontIcon iconLiteral="fas-user-tie" iconSize="18"/></graphic>
                    </Button>

                    <Label text="REPORTES" styleClass="menu-section"/>

                    <Button fx:id="btnReportes"
                            text="Reportes"
                            onAction="#abrirReportes"
                            styleClass="menu-button">
                        <graphic><FontIcon iconLiteral="fas-chart-line" iconSize="18"/></graphic>
                    </Button>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <center>
        <StackPane fx:id="stackContent" styleClass="content-area"/>
    </center>

</BorderPane>
