<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="root"
           styleClass="pos-theme branches-root"
           stylesheets="@/com/gerardgv/posclarity/css/theme/PosTheme.css,
                        @/com/gerardgv/posclarity/css/components/pos-card.css,
                        @/com/gerardgv/posclarity/css/components/pos-form.css,
                        @/com/gerardgv/posclarity/css/components/pos-buttons.css,
                        @/com/gerardgv/posclarity/css/components/pos-table.css,
                        @/com/gerardgv/posclarity/css/components/pos-textfield.css,
                        @/com/gerardgv/posclarity/css/components/pos-toast.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gerardgv.posclarity.controllers.BranchController">

    <HBox spacing="18"
          maxWidth="Infinity"
          maxHeight="Infinity">

        <!-- =====================================================
             FORMULARIO
             ===================================================== -->

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    prefWidth="430"
                    minWidth="430"
                    maxWidth="430"
                    styleClass="transparent-scroll">

            <content>

                <VBox spacing="14"
                      styleClass="pos-form-card">

                    <!-- TÍTULO -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="8">

                        <FontIcon iconLiteral="fas-store"
                                  iconSize="18"
                                  styleClass="clarity-section-icon"/>

                        <Label text="Sucursal"
                               styleClass="clarity-title"/>

                    </HBox>

                    <Label text="Alta y edición de sucursales"
                           styleClass="pos-form-subtitle"/>

                    <Separator/>


                    <!-- INFORMACIÓN GENERAL -->

                    <VBox spacing="4">

                        <HBox styleClass="pos-section-header">

                            <FontIcon iconLiteral="fas-building"
                                      iconSize="16"
                                      styleClass="pos-section-icon"/>

                            <Label text="Información general"
                                   styleClass="pos-section-title"/>

                        </HBox>

                        <Separator styleClass="pos-section-separator"/>

                    </VBox>


                    <!-- CAMPOS -->

                    <GridPane hgap="14"
                              vgap="12"
                              styleClass="pos-form-grid">

                        <columnConstraints>

                            <ColumnConstraints percentWidth="30"/>

                            <ColumnConstraints percentWidth="70"/>

                        </columnConstraints>

                        <children>

                            <!-- SUCURSAL -->

                            <Label text="Sucursal"
                                   styleClass="pos-form-label"/>

                            <TextField fx:id="txtSucursal"
                                       promptText="Nombre de la sucursal"
                                       maxWidth="Infinity"
                                       GridPane.columnIndex="1"/>


                            <!-- TELÉFONO -->

                            <Label text="Teléfono"
                                   styleClass="pos-form-label"
                                   GridPane.rowIndex="1"/>

                            <TextField fx:id="txtTelefono"
                                       promptText="Número telefónico"
                                       maxWidth="Infinity"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"/>


                            <!-- DIRECCIÓN -->

                            <Label text="Dirección"
                                   styleClass="pos-form-label"
                                   GridPane.rowIndex="2"/>

                            <TextField fx:id="txtDireccion"
                                       promptText="Dirección de la sucursal"
                                       maxWidth="Infinity"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="2"/>

                        </children>

                    </GridPane>


                    <Separator/>


                    <!-- BOTONES -->

                    <HBox styleClass="pos-form-footer">

                        <Button fx:id="btnLimpiar"
                                text="Limpiar"
                                minWidth="115"
                                onAction="#clearform"
                                styleClass="pos-btn">

                            <graphic>

                                <FontIcon iconLiteral="fas-eraser"
                                          iconSize="14"/>

                            </graphic>

                        </Button>

                        <Button fx:id="btnGuardar"
                                text="Guardar"
                                minWidth="115"
                                onAction="#saveBranch"
                                styleClass="pos-btn-primary">

                            <graphic>

                                <FontIcon iconLiteral="fas-save"
                                          iconSize="14"/>

                            </graphic>

                        </Button>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>


        <!-- =====================================================
             SUCURSALES REGISTRADAS
             ===================================================== -->

        <BorderPane minWidth="0"
                    minHeight="0"
                    styleClass="pos-card"
                    HBox.hgrow="ALWAYS">

            <!-- ENCABEZADO Y BÚSQUEDA -->

            <top>

                <VBox spacing="14">

                    <HBox alignment="CENTER_LEFT"
                          spacing="8">

                        <FontIcon iconLiteral="fas-store"
                                  iconSize="18"
                                  styleClass="clarity-section-icon"/>

                        <Label text="Sucursales registradas"
                               styleClass="clarity-title"/>

                    </HBox>


                    <!-- BUSCADOR -->

                    <HBox styleClass="clarity-search"
                          HBox.hgrow="ALWAYS">

                        <children>

                            <FontIcon iconLiteral="fas-search"
                                      iconSize="15"/>

                            <TextField fx:id="txtBuscar"
                                       promptText="Buscar por nombre o dirección..."
                                       HBox.hgrow="ALWAYS"/>

                        </children>

                    </HBox>

                    <padding>
                        <Insets bottom="14"/>
                    </padding>

                </VBox>

            </top>


            <!-- TABLA -->

            <center>

                <TableView fx:id="tblSucursales"
                           minHeight="0"
                           styleClass="pos-table">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"/>

                        <TableColumn fx:id="colSucursal"
                                     text="Sucursal"/>

                        <TableColumn fx:id="colTelefono"
                                     text="Teléfono"/>

                        <TableColumn fx:id="colDireccion"
                                     text="Dirección"/>

                        <TableColumn fx:id="colEstatus"
                                     text="Estado"/>

                        <TableColumn fx:id="colAcciones"
                                     text="Acciones"/>

                    </columns>

                </TableView>

            </center>


            <!-- FOOTER -->

            <bottom>

                <HBox minHeight="38"
                      prefHeight="38"
                      styleClass="clarity-table-footer">

                    <children>

                        <FontIcon iconLiteral="fas-store"
                                  iconSize="15"/>

                        <Label text="Directorio de sucursales"
                               styleClass="clarity-table-footer-label"/>

                    </children>

                    <BorderPane.margin>
                        <Insets top="8"/>
                    </BorderPane.margin>

                </HBox>

            </bottom>

        </BorderPane>

    </HBox>

</StackPane>