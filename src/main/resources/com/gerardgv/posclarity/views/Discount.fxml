<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gerardgv.posclarity.controllers.DiscountController">
   <center>
      <SplitPane fx:id="splitPane" dividerPositions="0.40" styleClass="main-split">
         <items>
            <ScrollPane fitToWidth="true" prefWidth="450.0">
               <content>
                  <VBox minWidth="450.0" prefWidth="450.0" spacing="10.0" styleClass="form-panel">
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                     <children>
                        <Label styleClass="form-title" text="Alta / Edición de Promoción" />
                        
                                    <GridPane hgap="15.0" prefHeight="144.0" prefWidth="406.0" vgap="18" VBox.vgrow="NEVER">
                          <columnConstraints>
                            <ColumnConstraints minWidth="130.0"  prefWidth="130.0" />
                            <ColumnConstraints hgrow="ALWAYS" />
                          </columnConstraints>
                          <rowConstraints>
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                              <RowConstraints minHeight="50.0" vgrow="NEVER" />
                          </rowConstraints>
                           <children>
                              <Label styleClass="form-label" text="Nombre" />
                              <TextField fx:id="txtNombre" maxWidth="Infinity" styleClass="text-field" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />
                              <Label styleClass="form-label" text="Tipo Aplicación" GridPane.rowIndex="1" />
                              <ComboBox fx:id="cbTipoAplicacion" maxWidth="Infinity" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              <Label styleClass="form-label" text="Tipo Valor" GridPane.rowIndex="2" />
                              <ComboBox fx:id="cbTipoValor" maxWidth="Infinity" styleClass="combo-box" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" />
                              <Label styleClass="form-label" text="Valor" GridPane.rowIndex="3" />
                              <TextField fx:id="txtValor" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                              <Label styleClass="form-label" text="Cupón" GridPane.rowIndex="4" />
                              <TextField fx:id="txtCupon" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                              <Label styleClass="form-label" text="Categoría" GridPane.rowIndex="5" />
                              <ComboBox fx:id="cbCategoria" maxWidth="Infinity" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                              <Label styleClass="form-label" text="Producto Beneficio" GridPane.rowIndex="6" />
                              <TextField fx:id="txtModeloProducto" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                              <Label text="Req. Armazón" GridPane.rowIndex="7" />
                              <CheckBox fx:id="chkRequiereArmazon" text="Sí" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                              <Label text="Dioptría Máx." GridPane.rowIndex="8" />
                              <TextField fx:id="txtDioptriaMax" promptText="3.00" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                              <Label styleClass="form-label" text="Fecha Inicio" GridPane.rowIndex="9" />
                              <DatePicker fx:id="dpInicio" GridPane.columnIndex="1" GridPane.rowIndex="9" />
                              <Label text="Fecha Fin" GridPane.rowIndex="10" />
                              <DatePicker fx:id="dpFin" GridPane.columnIndex="1" GridPane.rowIndex="10" />
                              <Label text="Prioridad" GridPane.rowIndex="11" />
                              <TextField fx:id="txtPrioridad" GridPane.columnIndex="1" GridPane.rowIndex="11" />
                           </children>
                           <VBox.margin>
                              <Insets left="10.0" right="15.0" />
                           </VBox.margin>
                           <padding>
                              <Insets bottom="20" left="25" right="25" top="20" />
                           </padding>
                        </GridPane>
                        <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                           <children>
                              <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primary" text="Guardar" />
                              <Button fx:id="btnClear" mnemonicParsing="false" onAction="#limpiar" styleClass="btn-secondary" text="Limpiar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            <VBox spacing="8.0">
               <children>
                  <HBox prefWidth="200.0" spacing="8.0" styleClass="table-panel">
                     <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar por código o nombre" styleClass="search-field" />
                     </children>
                  </HBox>
                  <TableView fx:id="tabla" prefHeight="252.0" prefWidth="776.0">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="75.0" text="Id" />
                      <TableColumn fx:id="colNombre" prefWidth="75.0" text="Promocion" />
                        <TableColumn fx:id="colTAplicacion" prefWidth="75.0" text="Aplicacion" />
                        <TableColumn fx:id="colTValor" prefWidth="75.0" text="Tipo Valor" />
                        <TableColumn fx:id="colValor" prefWidth="75.0" text="Valor" />
                        <TableColumn fx:id="colcupon" prefWidth="75.0" text="Cupon" />
                        <TableColumn fx:id="colCategoria" prefWidth="75.0" text="Categoria" />
                        <TableColumn fx:id="colFi" prefWidth="75.0" text="Fecha Inicio" />
                        <TableColumn fx:id="colFf" prefWidth="75.0" text="Fecha Final" />
                        <TableColumn fx:id="colPrioridad" prefWidth="75.0" text="Prioridad" />
                        <TableColumn fx:id="colActivo" prefWidth="75.0" text="Activo" />
                        <TableColumn fx:id="colAccion" prefWidth="75.0" text="Accion" />
                    </columns>
                  </TableView>
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </VBox>
         </items>
      </SplitPane>
   </center>
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="10.0" styleClass="header-bar">
         <padding>
            <Insets left="25" right="25" />
         </padding>
         <children>
            <Label styleClass="header-title" text="Gestión de Promociones" />
         </children>
      </HBox>
   </top>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER_RIGHT">
         <padding>
            <Insets top="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
