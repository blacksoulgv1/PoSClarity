<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.gerardgv.posclarity.controllers.SelectBranchController"
           style="-fx-background-color: #F3F6FA;">

    <children>
        <VBox alignment="CENTER"
              spacing="24"
              prefWidth="420"
              minWidth="360"
              maxWidth="420"
              style="-fx-background-color: white;
                     -fx-padding: 38 32 38 32;
                     -fx-background-radius: 16;
                     -fx-border-radius: 16;
                     -fx-border-color: #E2E8F0;
                     -fx-border-width: 1;">

            <children>

                <VBox alignment="CENTER" spacing="8">
                    <Label text="OC"
                           style="-fx-text-fill: #0F766E;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;"/>

                    <Label text="ÓPTICAS CLARITY"
                           style="-fx-text-fill: #172B4D;
                                  -fx-font-size: 17px;
                                  -fx-font-weight: bold;"/>

                    <Label text="PUNTO DE VENTA"
                           style="-fx-text-fill: #64748B;
                                  -fx-font-size: 11px;
                                  -fx-letter-spacing: 1px;"/>
                </VBox>

                <Separator/>

                <VBox spacing="10">
                    <Label text="Seleccionar sucursal"
                           style="-fx-text-fill: #172B4D;
                                  -fx-font-size: 18px;
                                  -fx-font-weight: bold;"/>

                    <Label text="Elige la sucursal donde vas a trabajar."
                           wrapText="true"
                           style="-fx-text-fill: #64748B;
                                  -fx-font-size: 12px;"/>

                    <ComboBox fx:id="cbBranch"
                              maxWidth="Infinity"
                              prefHeight="42"
                              promptText="Selecciona una sucursal"
                              style="-fx-background-radius: 8;
                                     -fx-border-radius: 8;"/>
                </VBox>

                <Button text="INICIAR"
                        onAction="#handleSeleccionar"
                        maxWidth="Infinity"
                        prefHeight="42"
                        style="-fx-background-color: #10B981;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;"/>

                <Label text="Acceso exclusivo para personal autorizado"
                       wrapText="true"
                       style="-fx-text-fill: #94A3B8;
                              -fx-font-size: 10px;"/>

            </children>
        </VBox>
    </children>
</StackPane>
